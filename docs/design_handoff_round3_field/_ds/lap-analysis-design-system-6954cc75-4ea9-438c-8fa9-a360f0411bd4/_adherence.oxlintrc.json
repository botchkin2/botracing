{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/charts/ChartHeader/**",
              "components/charts/DotStrip/**",
              "components/charts/LapTimeBars/**",
              "components/charts/TimeGrid/**",
              "components/charts/TraceChart/**",
              "components/charts/TrackMap/**",
              "components/charts/Transport/**",
              "components/controls/Button/**",
              "components/controls/Checkbox/**",
              "components/controls/SegmentedControl/**",
              "components/controls/Stepper/**",
              "components/controls/Switch/**",
              "components/feedback/EmptyState/**",
              "components/feedback/Skeleton/**",
              "components/feedback/StatusBanner/**",
              "components/feedback/StatusDot/**",
              "components/laps/CompareTray/**",
              "components/laps/LapChip/**",
              "components/laps/LapDetail/**",
              "components/laps/LapRow/**",
              "components/laps/LapTag/**",
              "components/laps/SessionRow/**",
              "components/laps/StintHeader/**",
              "ui_kits/lap-analysis/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:IBM Plex Mono|IBM Plex Sans Condensed))/i]",
        "message": "Font not provided by the design system. Available: IBM Plex Mono, IBM Plex Sans Condensed."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|onPress|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, onPress, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|tertiary|quiet)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'tertiary' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeaderValue'] > JSXAttribute > JSXIdentifier[name!=/^(?:color|text|hidden|onPress|key|key|ref|className|style|children)$/]",
        "message": "<HeaderValue> doesn't accept that prop. Declared props: color, text, hidden, onPress, key."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|color|onChange|size|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, color, onChange, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='CompareTray'] > JSXAttribute > JSXIdentifier[name!=/^(?:colors|label|count|onClear|onCompare|floating|key|ref|className|style|children)$/]",
        "message": "<CompareTray> doesn't accept that prop. Declared props: colors, label, count, onClear, onCompare, floating."
      },
      {
        "selector": "JSXOpeningElement[name.name='DotStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|unit|values|flip|width|format|onSelect|key|ref|className|style|children)$/]",
        "message": "<DotStrip> doesn't accept that prop. Declared props: label, unit, values, flip, width, format, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|detail|children|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, body, detail, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='LapChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|color|delta|deltaTone|isRef|status|progress|onPress|onRemove|onRetry|key|ref|className|style|children)$/]",
        "message": "<LapChip> doesn't accept that prop. Declared props: label, color, delta, deltaTone, isRef, status, progress, onPress, onRemove, onRetry."
      },
      {
        "selector": "JSXOpeningElement[name.name='LapChip'] > JSXAttribute[name.name='deltaTone'] > Literal[value!=/^(?:faster|slower|neutral)$/]",
        "message": "<LapChip> deltaTone must be one of 'faster' | 'slower' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LapChip'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:ready|loading|queued|failed)$/]",
        "message": "<LapChip> status must be one of 'ready' | 'loading' | 'queued' | 'failed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LapDetail'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|status|excluded|tags|reason|actionLabel|actionPrimary|onAction|key|ref|className|style|children)$/]",
        "message": "<LapDetail> doesn't accept that prop. Declared props: title, status, excluded, tags, reason, actionLabel, actionPrimary, onAction."
      },
      {
        "selector": "JSXOpeningElement[name.name='LapSector'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|best|key|ref|className|style|children)$/]",
        "message": "<LapSector> doesn't accept that prop. Declared props: value, best."
      },
      {
        "selector": "JSXOpeningElement[name.name='LapTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|value|key|ref|className|style|children)$/]",
        "message": "<LapTag> doesn't accept that prop. Declared props: kind, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='LapTag'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:best|out|in|part|slow|off|hit)$/]",
        "message": "<LapTag> kind must be one of 'best' | 'out' | 'in' | 'part' | 'slow' | 'off' | 'hit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LapBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:delta|color|best|key|ref|className|style|children)$/]",
        "message": "<LapBar> doesn't accept that prop. Declared props: delta, color, best."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|disabled|key|ref|className|style|children)$/]",
        "message": "<SegmentedOption> doesn't accept that prop. Declared props: value, label, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|track|car|time|laps|best|median|selected|onPress|key|ref|className|style|children)$/]",
        "message": "<SessionRow> doesn't accept that prop. Declared props: type, track, car, time, laps, best, median, selected, onPress."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionRow'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:R|Q|P)$/]",
        "message": "<SessionRow> type must be one of 'R' | 'Q' | 'P'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|radius|strong|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: width, height, radius, strong."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|actionLabel|onAction|dot|key|ref|className|style|children)$/]",
        "message": "<StatusBanner> doesn't accept that prop. Declared props: text, actionLabel, onAction, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusBanner'] > JSXAttribute[name.name='dot'] > Literal[value!=/^(?:idle|ok|waiting|none)$/]",
        "message": "<StatusBanner> dot must be one of 'idle' | 'ok' | 'waiting' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|label|detail|key|ref|className|style|children)$/]",
        "message": "<StatusDot> doesn't accept that prop. Declared props: status, label, detail."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:ok|idle|waiting)$/]",
        "message": "<StatusDot> status must be one of 'ok' | 'idle' | 'waiting'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|unit|onDecrement|onIncrement|key|ref|className|style|children)$/]",
        "message": "<Stepper> doesn't accept that prop. Declared props: value, unit, onDecrement, onIncrement."
      },
      {
        "selector": "JSXOpeningElement[name.name='StintHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|stats|onSelect|selectLabel|key|ref|className|style|children)$/]",
        "message": "<StintHeader> doesn't accept that prop. Declared props: title, stats, onSelect, selectLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimeGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|active|onSelect|cellHeight|key|ref|className|style|children)$/]",
        "message": "<TimeGrid> doesn't accept that prop. Declared props: columns, rows, active, onSelect, cellHeight."
      },
      {
        "selector": "JSXOpeningElement[name.name='Trace'] > JSXAttribute > JSXIdentifier[name!=/^(?:values|color|width|opacity|dash|key|ref|className|style|children)$/]",
        "message": "<Trace> doesn't accept that prop. Declared props: values, color, width, opacity, dash."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrackMap'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|outline|pit|laps|cars|sectionTicks|sectionLabels|cornerLabels|quality|mode|onModeChange|note|satellite|key|ref|className|style|children)$/]",
        "message": "<TrackMap> doesn't accept that prop. Declared props: width, height, outline, pit, laps, cars, sectionTicks, sectionLabels, cornerLabels, quality, mode, onModeChange, note, satellite."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrackMap'] > JSXAttribute[name.name='quality'] > Literal[value!=/^(?:good|fair|poor)$/]",
        "message": "<TrackMap> quality must be one of 'good' | 'fair' | 'poor'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TrackMap'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:follow|track|sat)$/]",
        "message": "<TrackMap> mode must be one of 'follow' | 'track' | 'sat'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Transport'] > JSXAttribute > JSXIdentifier[name!=/^(?:playing|onPlay|rates|rate|onRate|windowLabel|onWindowIn|onWindowOut|key|ref|className|style|children)$/]",
        "message": "<Transport> doesn't accept that prop. Declared props: playing, onPlay, rates, rate, onRate, windowLabel, onWindowIn, onWindowOut."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
