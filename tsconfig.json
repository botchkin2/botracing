{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // The uploader loads src/analysis with Node type stripping, which needs the .ts extension on relative imports (setStats.ts).
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // functions/ has its own tsconfig and dependencies (npm --prefix functions).
  "exclude": ["node_modules", "functions"]
}
