      "port": 8081
    },
    {
      "name": "web-live",
      "runtimeExecutable": "npx.cmd",
      "runtimeArgs": ["cross-env", "BROWSER=none", "EXPO_PUBLIC_LMU_API_BASE=https://botracing-61.web.app/api/lmu", "expo", "start", "--web", "--port", "19006"],
      "port": 19006
    }
  ]
