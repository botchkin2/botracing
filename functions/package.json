{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "build": "tsc",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:emulator": "npm run build && npx --yes firebase-tools@15.32.1 emulators:exec --config ../firebase.emulator.json --project demo-botracing --only functions,firestore,auth,storage \"node --test test/emulator/*.test.mjs\""
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "firebase": "^12.19.0",
    "firebase-functions-test": "^3.5.0",
    "typescript": "^5.0.0"
  },
  "private": true
}
