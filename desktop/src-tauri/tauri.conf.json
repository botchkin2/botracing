{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BotRacing",
  "version": "0.1.0",
  "identifier": "app.botracing.uploader",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "node scripts/stage-resources.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/app/": "app/",
      "resources/node/": "node/"
    }
  }
}
