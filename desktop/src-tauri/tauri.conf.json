{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BotRacing",
  "version": "0.1.0",
  "identifier": "app.botracing.uploader",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "node scripts/stage-resources.mjs"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/app/": "app/",
      "resources/node/": "node/"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzQ0MyNzBFNzIxMzlEMjcKUldRbm5STnlEaWZNQTJDVjFNK0Q1Q202T2pzbUk2emdtMEVpc2JkWWtOcUlaVHRKOGIwNUN5NzEK",
      "endpoints": [
        "https://botracing-61.web.app/api/tray/latest?target={{target}}&arch={{arch}}&current_version={{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
